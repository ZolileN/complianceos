// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth Models ──

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Added for credentials provider
  role          String    @default("consultant") // administrator, operations_manager, consultant, client
  isActive      Boolean   @default(true) // platform/tenant can disable login without deleting
  contactNumber String?
  resetToken        String?
  resetTokenExpires DateTime?
  // Bumped when sessions must be invalidated (disable, suspend, force logout)
  sessionVersion Int      @default(0)
  
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accounts      Account[]
  sessions      Session[]
  
  // ComplianceOS Relations
  assignedClients        Client[]
  completedStepProgresses WorkflowStepProgress[]
  uploadedDocuments      Document[]
  uploadedVersions       DocumentVersion[]
  assignedTasks          Task[]
  assignedConversations  Conversation[]
  assignedClientWorkflows ClientWorkflow[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     AuditLog[]
  notifications Notification[]
  adminAuditLogs AdminAuditLog[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── ComplianceOS Models ──

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("starter")
  isActive  Boolean  @default(true)
  settings  String   @default("{}") // SQLite doesn't support JSON, use String
  /// JSON overrides for Enterprise/custom deals, e.g. { "maxUsers": 50, "aiEnabled": true }
  limitsOverride String @default("{}")
  
  whatsappProvider       String    @default("twilio") // Twilio WhatsApp
  whatsappSetupComplete  Boolean   @default(false)
  whatsappVerifiedName   String?
  whatsappPhoneNumber    String?

  email                  String?
  contactNumber          String?
  address                String?
  website                String?

  users               User[]
  clients             Client[]
  workflowTemplates   WorkflowTemplate[]
  clientWorkflows     ClientWorkflow[]
  documents           Document[]
  tasks               Task[]
  conversations       Conversation[]
  messages            Message[]
  complianceItems     ComplianceItem[]
  skillReviews        SkillReview[]
  customSkills        Skill[] @relation("TenantSkills")
  skillSuggestions    SkillSuggestion[]
  subscription        Subscription?
  usageCounters       UsageCounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
}

/// Billing subscription for a tenant. Provider IDs stay empty until Stitch/Ozow checkout completes.
model Subscription {
  id        String @id @default(cuid())
  tenantId  String @unique
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plan      String // starter | growth | professional | enterprise
  status    String @default("trialing") // trialing | active | past_due | canceled | incomplete

  trialStartsAt      DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean  @default(false)
  canceledAt         DateTime?

  /// manual | stitch | ozow
  provider               String  @default("manual")
  providerCustomerId     String?
  providerSubscriptionId String?
  providerPlanId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([provider])
}

/// Pre-tenant signup checkout (pay-before-create for Growth/Professional).
model PendingSignup {
  id               String   @id @default(cuid())
  plan             String
  firmName         String
  fullName         String
  email            String
  passwordHash     String
  status           String   @default("pending") // pending | paid | completed | expired
  paymentReference String   @unique
  paymentPayload   String?  /// JSON Ozow form payload for redirect
  provider         String   @default("ozow")
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([status])
}

/// Metered usage buckets (e.g. whatsapp_messages for 2026-07).
model UsageCounter {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  metric    String   // whatsapp_messages | documents | skill_llm_tokens
  periodKey String   // YYYY-MM for monthly buckets
  quantity  Int      @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([tenantId, metric, periodKey])
  @@index([tenantId, metric])
}

model Client {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  companyName         String
  registrationNumber  String?
  taxNumber           String?
  vatNumber           String?
  directors           String   @default("[]") // JSON string
  email               String?
  phone               String?
  whatsappNumber      String?
  address             String?
  
  assignedConsultantId String?
  assignedConsultant   User?   @relation(fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  
  status              String   @default("active") // active, inactive, onboarding

  clientWorkflows     ClientWorkflow[]
  documents           Document[]
  tasks               Task[]
  conversations       Conversation[]
  complianceItems     ComplianceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  category    String   @default("custom")
  isActive    Boolean  @default(true)

  steps           WorkflowStep[]
  clientWorkflows ClientWorkflow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowStep {
  id          String   @id @default(cuid())
  templateId  String
  template    WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  stepOrder   Int      @default(0)
  slaDays     Int      @default(3)
  boundSkillSlug String?                    // Optional: auto-execute this skill when step becomes active
  requiredDocuments String @default("[]")   // JSON array of document category slugs
  autoComplete      Boolean @default(false)

  progress WorkflowStepProgress[]
}

model ClientWorkflow {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  templateId  String
  template    WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  status      String   @default("not_started") // not_started, in_progress, completed, cancelled
  
  assignedTo  String?
  assignee    User?    @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  progress    WorkflowStepProgress[]
  tasks       Task[]

  startedAt   DateTime?
  completedAt DateTime?
}

model WorkflowStepProgress {
  id                 String   @id @default(cuid())
  clientWorkflowId   String
  clientWorkflow     ClientWorkflow @relation(fields: [clientWorkflowId], references: [id], onDelete: Cascade)
  
  stepId             String
  step               WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Restrict)
  
  status             String   @default("pending") // pending, in_progress, completed, skipped
  notes              String?
  
  completedById      String?
  completedBy        User?    @relation(fields: [completedById], references: [id], onDelete: SetNull)

  completedAt        DateTime?
}

model Document {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  filePath    String
  fileType    String?
  category    String   @default("other")
  version     Int      @default(1)
  fileSize    BigInt   @default(0)
  
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  // Document Version Control & OCR Fields
  versions    DocumentVersion[]
  ocrStatus   String   @default("none") // none, pending, processing, completed, failed
  ocrText     String?
  ocrMetadata String?  // JSON string

  complianceItemId String?
  complianceItem   ComplianceItem? @relation(fields: [complianceItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  version      Int
  filePath     String
  fileType     String?
  fileSize     BigInt   @default(0)
  
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  assignedTo  String?
  assignee    User?    @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  
  workflowId  String?
  workflow    ClientWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  title       String
  description String?
  status      String   @default("new") // new, waiting_on_client, processing, submitted, completed, overdue
  priority    String   @default("medium") // low, medium, high, critical
  dueDate     DateTime?
  slaDays     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id              String   @id @default(cuid())
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  whatsappNumber  String
  status          String   @default("open") // open, closed, pending, archived
  
  assignedTo      String?
  assignee        User?    @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  messages        Message[]

  lastMessageAt   DateTime @default(now())
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  direction       String   // inbound, outbound
  content         String   @default("")
  messageType     String   @default("text") // text, image, document, audio, video, template
  mediaUrl        String?
  whatsappMessageId String?
  status          String   @default("sent") // sent, delivered, read, failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComplianceItem {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  category    String   // SARS, CIPC, Labour, BEE
  name        String   // e.g. VAT, PAYE, Income Tax, etc.
  status      String   @default("compliant") // compliant, action_required, critical, not_applicable
  dueDate     DateTime?
  lastChecked DateTime @default(now())
  notes       String?

  documents   Document[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, category, name])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action      String   // e.g., "CREATE", "UPDATE", "DELETE", "UPLOAD"
  entityType  String   // e.g., "Client", "Task", "Document", "User", "Workflow"
  entityId    String   // The ID of the affected record
  details     String   // JSON string containing metadata (e.g., changes made)
  
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  read      Boolean  @default(false)
  link      String?  // Optional path to redirect on click
  
  createdAt DateTime @default(now())
}

enum AdminActionType {
  SUSPEND_TENANT
  ACTIVATE_TENANT
  DISCONNECT_WHATSAPP
  VACUUM_DATABASE
  DELETE_TENANT
  CREATE_TENANT
  UPDATE_TENANT_PLAN
  DISABLE_USER
  ENABLE_USER
  UPDATE_USER_ROLE
  FORCE_LOGOUT
  COMPLETE_ONBOARDING
  REJECT_ONBOARDING
  REASSIGN_ONBOARDING
  START_TRIAL
  ACTIVATE_SUBSCRIPTION
  MARK_PAST_DUE
  CANCEL_SUBSCRIPTION
  UPDATE_LIMITS_OVERRIDE
}

model AdminAuditLog {
  id          String          @id @default(cuid())
  action      AdminActionType
  adminId     String
  admin       User            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminEmail  String
  targetId    String?         // ID of the target tenant or entity
  details     String          // JSON string for metadata
  createdAt   DateTime        @default(now())
}

// ── Skills.sh Execution Layer ──

model Skill {
  id            String   @id @default(cuid())
  slug          String   @unique              // e.g. "invoice-ocr"
  name          String                        // e.g. "Invoice OCR"
  description   String?
  version       String   @default("1.0.0")
  author        String   @default("PraxisOne Core")
  category      String                        // finance, hr, crm, whatsapp, compliance, general
  icon          String   @default("⚡")       // Emoji icon for display

  packId        String?
  pack          BusinessPack? @relation(fields: [packId], references: [id], onDelete: SetNull)

  // Skill definition
  skillDefinition    String                   // The SKILL.md content or instruction set
  triggers           String  @default("[]")   // JSON: ["document.uploaded", "message.received"]
  requiredPermissions String @default("[]")   // JSON: ["documents.read", "clients.write"]

  // Marketplace metadata
  isCore        Boolean  @default(false)       // Ships with PraxisOne
  isPublished   Boolean  @default(false)
  rating        Float    @default(0)
  installCount  Int      @default(0)

  // Relationships
  tenantId      String?
  tenant        Tenant?  @relation("TenantSkills", fields: [tenantId], references: [id], onDelete: Cascade)
  installations SkillInstallation[]
  executions    SkillExecution[]
  steps         SkillStep[]
  reviews       SkillReview[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SkillStep {
  id          String  @id @default(cuid())
  skillId     String
  skill       Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  name        String                          // e.g. "Extract Text"
  description String?
  stepOrder   Int     @default(0)
  stepType    String                          // llm_call, api_call, database_query, condition, human_approval
  config      String  @default("{}")          // JSON config for the step (prompt, endpoint, query, etc.)

  createdAt   DateTime @default(now())
}

model SkillInstallation {
  id          String   @id @default(cuid())
  tenantId    String
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  isActive    Boolean  @default(true)
  config      String   @default("{}")         // Tenant-specific config overrides

  installedAt DateTime @default(now())

  permissions SkillPermission[]

  @@unique([tenantId, skillId])
}

model SkillPermission {
  id              String  @id @default(cuid())
  installationId  String
  installation    SkillInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  permission      String                     // e.g. "crm.read", "whatsapp.send", "invoices.create"
  allowedRoles    String @default("[]")      // JSON: ["administrator", "operations_manager"]
  granted         Boolean @default(false)
  grantedBy       String?                    // userId of admin who approved

  @@unique([installationId, permission])
}

model SkillExecution {
  id            String   @id @default(cuid())
  tenantId      String
  skillId       String
  skill         Skill    @relation(fields: [skillId], references: [id])

  triggeredBy   String                       // userId or "system"
  triggerEvent  String                       // e.g. "document.uploaded", "manual"

  status        String   @default("pending") // pending, running, completed, failed, cancelled

  // Input/Output
  input         String   @default("{}")      // JSON
  output        String?                      // JSON
  error         String?

  // Metrics
  stepsCompleted Int     @default(0)
  totalSteps     Int     @default(0)
  tokensUsed     Int     @default(0)
  durationMs     Int?
  /// 0-based step index waiting on human approval (null when not paused)
  pausedAtStepOrder Int?

  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
}

model BusinessPack {
  id          String   @id @default(cuid())
  slug        String   @unique               // e.g. "construction-pack"
  name        String                          // e.g. "Construction Pack"
  description String?
  industry    String                          // construction, medical, legal, real-estate, accounting
  icon        String   @default("📦")
  price       Int      @default(0)            // Monthly price in cents (ZAR)

  skills      Skill[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SkillReview {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  rating    Int      // 1 to 5
  comment   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, skillId])
}

model SkillSuggestion {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  title           String
  description     String
  triggerEvent    String
  suggestedSteps  String   // JSON array of suggested steps
  
  status          String   @default("pending") // pending, accepted, dismissed
  
  createdAt       DateTime @default(now())
}


