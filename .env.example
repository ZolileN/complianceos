# ── Core ─────────────────────────────────────────────────────
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── File storage (UploadThing) ───────────────────────────────
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# ── WhatsApp (Twilio) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
# TWILIO_SKIP_OTP=true

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
# Verified sending domain address for outbound mail (replies, alerts, invites)
RESEND_FROM_EMAIL=no-reply@praxis.mlkcomputer.com
# Inbound: configure Resend webhook → POST /api/webhooks/resend
# Tenant routing: {tenantSlug}@INBOUND_EMAIL_DOMAIN (or *.resend.app on free tier)
INBOUND_EMAIL_DOMAIN=soleiistau.resend.app
# Optional: show correct hint in client UI after build
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=soleiistau.resend.app
BOOK_DEMO_EMAIL=
CONTACT_SALES_EMAIL=
CONTACT_EMAIL=

# ── Cron (Vercel + external cron-job.org) ────────────────────
CRON_SECRET=

# ── Redis (required in production) ───────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=

# ── Billing (Paystack primary; Ozow fallback) ─────────────────
# Paystack is used whenever PAYSTACK_SECRET_KEY is set, even if BILLING_PROVIDER=ozow.
BILLING_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_IS_TEST=true

# ── Skills LLM (optional — use SKILL_LLM_SIMULATE=true locally) ──
# OPENAI_API_KEY=
# SKILL_LLM_SIMULATE=true

# ── CIPC registry (Phase 1B — optional; default: ocr) ─────────
# CIPC_PROVIDER=ocr
# CIPC_API_BASE_URL=
# CIPC_CLIENT_ID=
# CIPC_CLIENT_SECRET=
# CIPC_SUBSCRIPTION_KEY=
# CIPC_OAUTH_TOKEN_URL=
# CIPC_AGGREGATOR_BASE_URL=
# CIPC_AGGREGATOR_API_KEY=

# ── Sentry (production) ──────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
