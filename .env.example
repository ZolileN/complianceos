# ── Core ─────────────────────────────────────────────────────
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── File storage (UploadThing) ───────────────────────────────
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# ── WhatsApp (Twilio) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
# TWILIO_SKIP_OTP=true

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
# Verified sending domain address for outbound mail (replies, alerts, invites)
RESEND_FROM_EMAIL=no-reply@praxis.mlkcomputer.com
# Inbound: configure Resend webhook → POST /api/webhooks/resend
# Tenant routing: {tenantSlug}@INBOUND_EMAIL_DOMAIN (or *.resend.app on free tier)
INBOUND_EMAIL_DOMAIN=soleiistau.resend.app
# Optional: show correct hint in client UI after build
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=soleiistau.resend.app
BOOK_DEMO_EMAIL=
CONTACT_SALES_EMAIL=
CONTACT_EMAIL=

# ── Cron (Vercel + external cron-job.org) ────────────────────
CRON_SECRET=

# ── Redis (required in production) ───────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=

# ── Billing (Ozow / Stitch) ──────────────────────────────────
BILLING_PROVIDER=ozow
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_IS_TEST=true
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_REDIRECT_URI=
STITCH_API_URL=https://api.stitch.money/graphql

# ── Skills LLM (optional — use SKILL_LLM_SIMULATE=true locally) ──
# OPENAI_API_KEY=
# SKILL_LLM_SIMULATE=true

# ── Sentry (production) ──────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
