# ── Core ─────────────────────────────────────────────────────
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── File storage (UploadThing v7) ────────────────────────────
# Base64 token from UploadThing dashboard → API Keys (not legacy SECRET/APP_ID)
UPLOADTHING_TOKEN=

# ── WhatsApp (Twilio) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
# Exact public webhook URL Twilio calls (production signature validation)
# TWILIO_WEBHOOK_URL=https://your-app.example.com/api/webhooks/twilio
# TWILIO_ENFORCE_SIGNATURE=true
# TWILIO_SKIP_OTP=true   # sandbox/trial only — never in production

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
# Verified sending domain for outbound mail (replies, alerts, invites)
RESEND_FROM_EMAIL=no-reply@example.com
# Inbound: Resend webhook → POST /api/webhooks/resend
# Tenant routing: {tenantSlug}@INBOUND_EMAIL_DOMAIN
INBOUND_EMAIL_DOMAIN=
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=
BOOK_DEMO_EMAIL=
CONTACT_SALES_EMAIL=
CONTACT_EMAIL=

# ── Cron (Vercel + external cron-job.org) ────────────────────
# Required for all /api/cron/* routes (Vercel sends Authorization: Bearer)
CRON_SECRET=

# ── Redis (required in production for skills + admin telemetry) ─
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# REDIS_URL=

# ── Billing (Paystack primary; Ozow when Paystack not configured) ─
# Paystack wins whenever PAYSTACK_SECRET_KEY is set, even if BILLING_PROVIDER=ozow
BILLING_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_API_URL=https://api.paystack.co
# Webhook: POST /api/billing/paystack/webhook
# Browser return: GET /api/billing/paystack/callback
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_IS_TEST=true

# ── Skills LLM (optional) ────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# SKILL_LLM_SIMULATE=true

# ── CIPC registry (default: ocr — no API credentials required) ─
# CIPC_PROVIDER=ocr
# Direct CIPC gateway (when CIPC_PROVIDER=direct):
# CIPC_API_BASE_URL=
# CIPC_CLIENT_ID=
# CIPC_CLIENT_SECRET=
# CIPC_SUBSCRIPTION_KEY=
# CIPC_OAUTH_TOKEN_URL=
# Aggregator (when CIPC_PROVIDER=aggregator):
# CIPC_AGGREGATOR_BASE_URL=
# CIPC_AGGREGATOR_API_KEY=

# ── Sentry (production) ──────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
